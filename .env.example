# LifeStory Agent - Environment Variables
# Copy this file to .env and fill in your values

# Database (SQLite for development, can use PostgreSQL URL for production)
DATABASE_URL="file:./dev.db"

# NextAuth.js Configuration
# Generate a secret: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here"
AUTH_URL="http://localhost:3000"

# Claude API Key (from https://console.anthropic.com/)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Resend API Key for password reset emails (from https://resend.com/)
RESEND_API_KEY="your-resend-api-key-here"
EMAIL_FROM="LifeStory <noreply@yourdomain.com>"

# Cloudinary for image uploads (from https://cloudinary.com/)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
