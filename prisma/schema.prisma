generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  profile    Profile?
  lifeEvents LifeEvent[]
  interviews Interview[]
  apiUsage   ApiUsage[]
}

model Profile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String?
  birthDate DateTime?
  birthPlace String?
  language  String?   @default("en")
  updatedAt DateTime  @updatedAt
}

model LifeEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  date        DateTime?
  period      String?
  category    String?
  emotions    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  interviewId String?
  interview   Interview? @relation(fields: [interviewId], references: [id])
}

model Interview {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentPeriod   String
  conversationLog String
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  extractedEvents LifeEvent[]
}

model ApiUsage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputTokens  Int
  outputTokens Int
  model        String
  endpoint     String   // 'chat', 'extract', 'life-script', 'opening'
  costUsd      Float
  createdAt    DateTime @default(now())
}
