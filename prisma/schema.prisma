generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  apiUsage     ApiUsage[]
  interviews   Interview[]
  lifeEvents   LifeEvent[]
  profile      Profile?
}

model Profile {
  id         String    @id @default(cuid())
  userId     String    @unique
  fullName   String?
  birthDate  DateTime?
  birthPlace String?
  language   String?   @default("en")
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LifeEvent {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String
  date        DateTime?
  period      String?
  category    String?
  emotions    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  interviewId String?
  interview   Interview? @relation(fields: [interviewId], references: [id])
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Interview {
  id              String      @id @default(cuid())
  userId          String
  currentPeriod   String
  conversationLog String
  status          String      @default("active")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  extractedEvents LifeEvent[]
}

model ApiUsage {
  id           String   @id @default(cuid())
  userId       String
  inputTokens  Int
  outputTokens Int
  model        String
  endpoint     String
  costUsd      Float
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
