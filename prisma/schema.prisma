generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  apiUsage     ApiUsage[]
  interviews   Interview[]
  lifeEvents   LifeEvent[]
  profile      Profile?
  media        Media[]
  sharedStories SharedStory[]
  people        Person[]
}

model Profile {
  id         String    @id @default(cuid())
  userId     String    @unique
  fullName   String?
  birthDate  DateTime?
  birthPlace String?
  language   String?   @default("en")
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LifeEvent {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String
  date        DateTime?
  endDate     DateTime?
  period      String?
  category    String?
  emotions    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  interviewId String?
  interview   Interview? @relation(fields: [interviewId], references: [id])
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  media       Media[]

  @@index([userId])
}

model Interview {
  id              String      @id @default(cuid())
  userId          String
  currentPeriod   String
  conversationLog String
  status          String      @default("active")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  extractedEvents LifeEvent[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, updatedAt])
}

model ApiUsage {
  id           String   @id @default(cuid())
  userId       String
  inputTokens  Int
  outputTokens Int
  model        String
  endpoint     String
  costUsd      Float
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Media {
  id          String     @id @default(cuid())
  userId      String
  url         String
  publicId    String     @unique
  type        String     @default("image")
  title       String?
  description String?
  width       Int?
  height      Int?
  size        Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifeEventId String?
  lifeEvent   LifeEvent? @relation(fields: [lifeEventId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Person {
  id           String   @id @default(cuid())
  userId       String
  name         String
  relationship String   @default("Person")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SharedStory {
  id           String    @id @default(cuid())
  userId       String
  shareCode    String    @unique
  title        String?
  isPublic     Boolean   @default(false)
  password     String?
  expiresAt    DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  content      String?   @db.Text
  periodsIncluded String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
